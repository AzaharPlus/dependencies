 namespace QtDarwinFutex {
 
+namespace Ulock {
+enum : uint32_t {
+    CompareAndWait = 1,
+    CompareAndWait64 = 5,
+    WakeAll = 0x00000100,
+    NoErrno = 0x01000000,
+};
+
+template <typename Atomic>
+constexpr uint32_t operation()
+{
+    return (sizeof(typename Atomic::Type) == 8 ? CompareAndWait64 : CompareAndWait) | NoErrno;
+}
+
+template <typename Atomic>
+inline uint64_t value(typename Atomic::Type v)
+{
+    using T = typename Atomic::Type;
+    if constexpr (std::is_pointer_v<T>)
+        return uint64_t(quintptr(v));
+    else // zero-extend, the kernel rejects 32-bit compare values with high bits set
+        return uint64_t(std::make_unsigned_t<T>(v));
+}
+} // namespace Ulock
